{
  "cli": { "version": ">= 7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://YOUR-API-HOST/api",
        "SOCKET_URL": "https://YOUR-API-HOST",
        "WEB_URL": "https://YOUR-WEB-HOST"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://YOUR-API-HOST/api",
        "SOCKET_URL": "https://YOUR-API-HOST",
        "WEB_URL": "https://YOUR-WEB-HOST"
      }
    }
  },
  "submit": { "production": {} }
}
